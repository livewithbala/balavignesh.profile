# Netlify: always revalidate HTML and the version file; let versioned assets cache safely.
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
/*.js
  Cache-Control: public, max-age=0, must-revalidate
/*.css
  Cache-Control: public, max-age=0, must-revalidate
